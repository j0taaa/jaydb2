{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext", "skipLibCheck": true,
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "../typescript/src/**/*.ts"]
}
