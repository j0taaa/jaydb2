# Witnesses of checks before fields generated by the actual Codec.
import Base
import ../contract/Data.bend as D
import ../contract/Protocol.bend as P
import ../src/State.bend as E
import ./CodecRefusals.bend as R
import ../src/Codec.bend as C
import ../contract/Bytes.bend as B
import ./PrimitivesService.bend as M
import ./RoutesService.bend as Route
import ../contract/Semantics.bend as S
import ../contract/Resources.bend as X
import ../src/Core.bend as N
import ./ProtocolService.bend as Q
import ../contract/Logic.bend as L
import ./Foundations.bend as F

# Every generated field has its check immediately before it.
def BeforeOfField(-qs: List<&2, Q.Frame>, -t: Nat, -p: Nat, -n: Nat) -> Type:
  &b: Nat -> L.E<{Nat.is_lt(b, t) == True{} : Bool},
    {Q.query(qs, b) == Some{Q.Checked{p, n}} : Maybe<&2, Q.Frame>}>

def is_field(q: Q.Frame) -> Bool:
  match q:
    case Q.Constructed{p, n}: True{}
    case _: False{}

def check_of(q: Q.Frame) -> Q.Frame:
  match q:
    case Q.Constructed{p, n}: Q.Checked{p, n}
    case _: Q.Checked{0n, 0n}

def shift_field(-h: Q.Frame, -qs: List<&2, Q.Frame>, -t: Nat,
  -p: Nat, -n: Nat, before: BeforeOfField(qs, t, p, n)) ->
  BeforeOfField(Con{h, qs}, Succ{t}, p, n):
  match before:
    case (b, L.Both{order, checked}): (Succ{b}, L.Both{order, checked})

def traverse_head(+h: Q.Frame, +qs: List<&2, Q.Frame>, t: Nat, -p: Nat, -n: Nat,
  negative: {is_field(h) == False{} : Bool},
  obtained: {Q.query(Con{h, qs}, t) == Some{Q.Constructed{p, n}} : Maybe<&2, Q.Frame>},
  tail: @u: Nat -> {Q.query(qs, u) == Some{Q.Constructed{p, n}} : Maybe<&2, Q.Frame>} -> BeforeOfField(qs, u, p, n)) ->
  BeforeOfField(Con{h, qs}, t, p, n):
  match t:
    case 0n:
      F.absurd_boolean(BeforeOfField(Con{h, qs}, 0n, p, n),
        Equal.trans(Bool, False{}, is_field(h), True{},
          Equal.sym(Bool, is_field(h), False{}, negative),
          Equal.cong(Q.Frame, Bool, is_field, h, Q.Constructed{p, n},
            F.some_injective(Q.Frame, h, Q.Constructed{p, n}, obtained))))
    case 1n+u: shift_field(h, qs, u, p, n, tail(u, obtained))

def traverse_pair(+p0: Nat, +n0: Nat, +qs: List<&2, Q.Frame>, t: Nat, -p: Nat, -n: Nat,
  obtained: {Q.query(Con{Q.Checked{p0, n0}, Con{Q.Constructed{p0, n0}, qs}}, t) == Some{Q.Constructed{p, n}} : Maybe<&2, Q.Frame>},
  tail: @u: Nat -> {Q.query(qs, u) == Some{Q.Constructed{p, n}} : Maybe<&2, Q.Frame>} -> BeforeOfField(qs, u, p, n)) ->
  BeforeOfField(Con{Q.Checked{p0, n0}, Con{Q.Constructed{p0, n0}, qs}}, t, p, n):
  match t:
    case 0n:
      F.absurd_boolean(BeforeOfField(Con{Q.Checked{p0, n0}, Con{Q.Constructed{p0, n0}, qs}}, 0n, p, n),
        Equal.cong(Q.Frame, Bool, is_field, Q.Checked{p0, n0}, Q.Constructed{p, n},
          F.some_injective(Q.Frame, Q.Checked{p0, n0}, Q.Constructed{p, n}, obtained)))
    case 1n+u:
      match u:
        case 0n:
          (0n, L.Both{{==}, Equal.cong(Q.Frame, Maybe<&2, Q.Frame>, q => Some{check_of(q)},
            Q.Constructed{p0, n0}, Q.Constructed{p, n}, F.some_injective(Q.Frame,
              Q.Constructed{p0, n0}, Q.Constructed{p, n}, obtained))})
        case 1n+v:
          shift_field(Q.Checked{p0, n0}, Con{Q.Constructed{p0, n0}, qs}, Succ{v}, p, n,
            shift_field(Q.Constructed{p0, n0}, qs, v, p, n, tail(v, obtained)))

# Concatenation preserves the earlier witness, including across phases.
def FieldsSafe(-qs: List<&2, Q.Frame>) -> Type:
  @t: Nat -> @p: Nat -> @n: Nat ->
    {Q.query(qs, t) == Some{Q.Constructed{p, n}} : Maybe<&2, Q.Frame>} -> BeforeOfField(qs, t, p, n)

def field_in_left(+xs: List<&2, Q.Frame>, -ys: List<&2, Q.Frame>, -t: Nat,
  -p: Nat, -n: Nat, before: BeforeOfField(xs, t, p, n)) -> BeforeOfField(Q.concatenate(xs, ys), t, p, n):
  match before:
    case (+b, L.Both{order, query_result}):
      (b, L.Both{order, Q.query_prefix(xs, ys, b, Q.Checked{p, n}, query_result)})

def field_in_right(+xs: List<&2, Q.Frame>, -ys: List<&2, Q.Frame>, -t: Nat,
  -p: Nat, -n: Nat, before: BeforeOfField(ys, t, p, n)) ->
  BeforeOfField(Q.concatenate(xs, ys), Nat.add(Q.size(xs), t), p, n):
  match before:
    case (b, L.Both{order, query_result}):
      (Nat.add(Q.size(xs), b), L.Both{Q.order_shifted(Q.size(xs), b, t, order),
        Equal.trans(Maybe<&2, Q.Frame>, Q.query(Q.concatenate(xs, ys), Nat.add(Q.size(xs), b)),
          Q.query(ys, b), Some{Q.Checked{p, n}}, Q.query_after_prefix(xs, ys, b), query_result)})

def field_of_part(+xs: List<&2, Q.Frame>, +ys: List<&2, Q.Frame>, +t: Nat,
  +p: Nat, +n: Nat, a: FieldsSafe(xs), b: FieldsSafe(ys),
  part: Q.Part(xs, ys, t, Q.Constructed{p, n})) -> BeforeOfField(Q.concatenate(xs, ys), t, p, n):
  match part:
    case L.Left{(i, L.Both{pos, query_result})}:
      %Equal.sym(Nat, t, i, pos) : BeforeOfField(Q.concatenate(xs, ys), _, p, n)
      field_in_left(xs, ys, i, p, n, a(i, p, n, query_result))
    case L.Right{(i, L.Both{pos, query_result})}:
      %Equal.sym(Nat, t, Nat.add(Q.size(xs), i), pos) : BeforeOfField(Q.concatenate(xs, ys), _, p, n)
      field_in_right(xs, ys, i, p, n, b(i, p, n, query_result))

law concatenate_fields_safe:
  for +xs: List<&2, Q.Frame>
  for +ys: List<&2, Q.Frame>
  for a: FieldsSafe(xs)
  for b: FieldsSafe(ys)
  FieldsSafe(Q.concatenate(xs, ys))
def concatenate_fields_safe(xs, ys, a, b):
  +t => +p => +n => query_result =>
    field_of_part(xs, ys, t, p, n, a, b, Q.divide_query(xs, ys, t, Q.Constructed{p, n}, query_result))

def fields_empty(t: Nat, -p: Nat, -n: Nat,
  query_result: {Q.query(Nil{}, t) == Some{Q.Constructed{p, n}} : Maybe<&2, Q.Frame>}) ->
  BeforeOfField(Nil{}, t, p, n):
  match t:
    case 0n: L.ex_false(BeforeOfField(Nil{}, 0n, p, n), F.none_negative_some(Q.Frame, Q.Constructed{p, n}, query_result))
    case 1n+k: L.ex_false(BeforeOfField(Nil{}, 1n+k, p, n), F.none_negative_some(Q.Frame, Q.Constructed{p, n}, query_result))

def empty_safe() -> FieldsSafe(Nil{}):
  t => p => n => query_result => fields_empty(t, p, n, query_result)

def without_field(+h: Q.Frame, negative: {is_field(h) == False{} : Bool}) -> FieldsSafe([h]):
  t => p => n => query_result => traverse_head(h, Nil{}, t, p, n, negative, query_result,
    u => obtained => fields_empty(u, p, n, obtained))

def construct_fields(c: C.Check, +pos: Nat, +q: Nat) -> FieldsSafe(M.construct(c, pos, q)):
  match c:
    case C.Fits{}: t => p => n => query_result => traverse_pair(pos, q, Nil{}, t, p, n, query_result,
      u => obtained => fields_empty(u, p, n, obtained))
    case C.Short{}: empty_safe()
    case C.Large{}: empty_safe()

def opening_fields(c: C.Check, ready: Bool, +pos: Nat, +q: Nat) ->
  FieldsSafe(M.open_field(c, ready, pos, q)):
  match c ready:
    case C.Fits{} True{}: construct_fields(C.Fits{}, pos, q)
    case C.Fits{} False{}: without_field(Q.Checked{pos, q}, {==})
    case C.Short{} _: empty_safe()
    case C.Large{} _: empty_safe()

def frame_field_safe(+pos: Nat, +f: C.Purpose, +high: U32, +low: U32,
  +stack: C.Stack, +body: B.Number64, +ceiling: B.Number64) ->
  FieldsSafe(M.frame_field(pos, f, high, low, stack, body, ceiling)):
  opening_fields(M.check(f, high, low, stack, body, ceiling),
    M.open_name_valid(f, high, low), pos, M.count(high, low))

def tag_fields(tag: Nat, +pos: Nat) -> FieldsSafe(M.frame_tag(tag, pos)):
  match tag:
    case 0n: construct_fields(C.Fits{}, pos, 1n)
    case 1n: construct_fields(C.Fits{}, pos, 1n)
    case 2n: construct_fields(C.Fits{}, pos, 1n)
    case 3n+k: empty_safe()

def word_fields(f: C.Purpose, +high: U32, +low: U32, +stack: C.Stack,
  +body: B.Number64, +ceiling: B.Number64, +pos: Nat) ->
  FieldsSafe(M.frame_word(f, high, low, stack, body, ceiling, pos)):
  match f:
    case C.Integer{}: construct_fields(C.Fits{}, pos, 8n)
    case C.TextValue{}: frame_field_safe(pos, C.TextValue{}, high, low, stack, body, ceiling)
    case C.NameText{}: frame_field_safe(pos, C.NameText{}, high, low, stack, body, ceiling)
    case C.CountsList{}: frame_field_safe(pos, C.CountsList{}, high, low, stack, body, ceiling)
    case C.CountsRecord{}: frame_field_safe(pos, C.CountsRecord{}, high, low, stack, body, ceiling)

def step_fields(m: C.Machine, +b: U32, +body: B.Number64, +ceiling: B.Number64, +pos: Nat) ->
  FieldsSafe(M.frame_step(m, b, body, ceiling, pos)):
  match m:
    case C.Tag{stack}: tag_fields(U32.to_nat(b), pos)
    case C.WordInput{f, 0n, high, +low, stack}:
      word_fields(f, (high * 256 + U32.shrn(low, 24n) : U32), (low * 256 + b : U32), stack, body, ceiling, pos)
    case C.WordInput{f, 1n+k, high, low, stack}: empty_safe()
    case C.TagName{stack}: empty_safe()
    case C.Content{name, last, q, u, text, stack}: empty_safe()
    case C.DecodedReady{v}: empty_safe()
    case C.Invalid{}: empty_safe()
    case C.Above{}: empty_safe()

law codec_checks_before_of_construct:
  for bs: List<&2, U32>
  for +m: C.Machine
  for +body: B.Number64
  for +ceiling: B.Number64
  for +pos: Nat
  FieldsSafe(M.frames_codec(bs, m, body, ceiling, pos))
def codec_checks_before_of_construct(bs, m, body, ceiling, pos):
  match bs:
    case Nil{}: empty_safe()
    case Con{+b, +rest}:
      concatenate_fields_safe(M.frame_step(m, b, C.decrease64(body), C.decrease64(ceiling), pos),
        M.frames_codec(rest, C.step(m, b, C.decrease64(body), C.decrease64(ceiling)), C.decrease64(body), C.decrease64(ceiling), Succ{pos}),
        step_fields(m, b, C.decrease64(body), C.decrease64(ceiling), pos),
        codec_checks_before_of_construct(rest, C.step(m, b, C.decrease64(body), C.decrease64(ceiling)), C.decrease64(body), C.decrease64(ceiling), Succ{pos}))

def admitted_fields(ok: Bool, +bs: List<&2, U32>, +body: B.Number64, +ceiling: B.Number64) ->
  FieldsSafe(M.decoding_admitted(ok, bs, body, ceiling)):
  match ok:
    case False{}: empty_safe()
    case True{}:
      concatenate_fields_safe(M.frames_codec(bs, C.Tag{C.Root{}}, body, ceiling, 0n),
        [Q.Decoded{bs, R.optional(C.decode(bs, ceiling))}],
        codec_checks_before_of_construct(bs, C.Tag{C.Root{}}, body, ceiling, 0n),
        without_field(Q.Decoded{bs, R.optional(C.decode(bs, ceiling))}, {==}))

def measure_fields(q: Maybe<&2, B.Number64>, +bs: List<&2, U32>, +ceiling: B.Number64) ->
  FieldsSafe(M.decoding_measure(q, bs, ceiling)):
  match q:
    case None{}: empty_safe()
    case Some{+body}: admitted_fields(C.less_equal64(body, ceiling) && B.octets_all_valid(bs), bs, body, ceiling)

def abstraction_fields(q: Maybe<&2, D.State>, +s: D.State, +bs: List<&2, U32>) ->
  FieldsSafe(M.store_abstraction(q, s, bs)):
  match q:
    case None{}: empty_safe()
    case Some{a}: without_field(Q.Stored{s, bs, a}, {==})

def storage_fields(q: Maybe<&2, List<&2, U32>>, +e: D.Schema, +s: D.State) ->
  FieldsSafe(M.store_bytes(q, e, s)):
  match q:
    case None{}: empty_safe()
    case Some{bs}: abstraction_fields(E.decode(D.state_value(s), e), s, bs)

def check_in_prefix(+cut: Nat, +qs: List<&2, Q.Frame>, +t: Nat,
  -p: Nat, -n: Nat, inside: {Nat.is_lt(t, cut) == True{} : Bool}, before: BeforeOfField(qs, t, p, n)) ->
  BeforeOfField(Q.first(cut, qs), t, p, n):
  match before:
    case (+b, L.Both{+order, query_result}):
      (b, L.Both{order, Equal.trans(Maybe<&2, Q.Frame>, Q.query(Q.first(cut, qs), b), Q.query(qs, b), Some{Q.Checked{p, n}},
        Q.query_before_of_cut_and_preserved(cut, qs, b, Q.less_transitive(b, t, cut, order, inside)), query_result)})

law first_preserve_fields_safe:
  for +cut: Nat
  for +qs: List<&2, Q.Frame>
  for safe: FieldsSafe(qs)
  FieldsSafe(Q.first(cut, qs))
def first_preserve_fields_safe(cut, qs, safe):
  +t => +p => +n => +query_result =>
    check_in_prefix(cut, qs, t, p, n,
      Q.query_in_prefix_respects_cut(cut, qs, t, Q.Constructed{p, n}, query_result),
      safe(t, p, n, Q.query_in_prefix_and_real(cut, qs, t, Q.Constructed{p, n}, query_result)))

law primitive_checks_before_of_construct:
  for q: M.Primitive
  FieldsSafe(M.expand(q))
def primitive_checks_before_of_construct(q):
  match q:
    case M.Prefix{+n, +p}: first_preserve_fields_safe(n, M.expand(p), primitive_checks_before_of_construct(p))
    case M.Encode{+v}: without_field(Q.Encoded{v, P.encode(v)}, {==})
    case M.Decode{+bs, +ceiling}: measure_fields(B.nat64(B.length(bs)), bs, ceiling)
    case M.Store{e, +s}: storage_fields(P.encode(D.state_value(s)), e, s)
    case M.Read{a, cap, b, d}: without_field(Q.Read{a, b, d}, {==})

law primitives_check_before_of_construct:
  for xs: List<&2, M.Primitive>
  FieldsSafe(M.expand_primitives(xs))
def primitives_check_before_of_construct(xs):
  match xs:
    case Nil{}: empty_safe()
    case Con{+h, +t}:
      concatenate_fields_safe(M.expand(h), M.expand_primitives(t),
        primitive_checks_before_of_construct(h), primitives_check_before_of_construct(t))

# Frames of other phases do not construct protocol fields.
def WithoutFields(xs: List<&2, Q.Frame>) -> Type:
  match xs:
    case Nil{}: Unit
    case Con{h, t}: L.E<{is_field(h) == False{} : Bool}, WithoutFields(t)>

def list_without_fields(xs: List<&2, Q.Frame>, proofs: WithoutFields(xs)) -> FieldsSafe(xs):
  match xs proofs:
    case Nil{} _: empty_safe()
    case Con{+h, +t} L.Both{head, tail}:
      concatenate_fields_safe([h], t, without_field(h, head), list_without_fields(t, tail))

def execution_without_fields(+r: P.Request, +ctx: D.Context, xs: List<&2, Q.FrameExec>) ->
  WithoutFields(Q.expand_exec(r, ctx, xs)):
  match xs:
    case Nil{}: Unit{}
    case Con{Q.Evaluation{execution_trace}, t}: L.Both{{==}, execution_without_fields(r, ctx, t)}
    case Con{Q.Operation{e, s, o, result}, t}: L.Both{{==}, execution_without_fields(r, ctx, t)}

def micro_input(m: Route.Micro) -> FieldsSafe(Route.micro_input(m)):
  match m:
    case Route.Micro{a, b, c, d}: primitives_check_before_of_construct(a)
def micro_authentication(m: Route.Micro) -> FieldsSafe(Route.micro_authentication(m)):
  match m:
    case Route.Micro{a, b, c, d}: primitives_check_before_of_construct(b)
def micro_execution(m: Route.Micro) -> FieldsSafe(Route.micro_execution(m)):
  match m:
    case Route.Micro{a, b, c, d}: primitives_check_before_of_construct(c)
def micro_output(m: Route.Micro) -> FieldsSafe(Route.micro_output(m)):
  match m:
    case Route.Micro{a, b, c, d}: primitives_check_before_of_construct(d)

def received_fields(+m: Route.Micro, +r: P.Request) -> FieldsSafe(Route.render_received(m, r)):
  concatenate_fields_safe(Route.micro_input(m), [Q.Received{r}], micro_input(m), without_field(Q.Received{r}, {==}))

def authenticated_fields(+m: Route.Micro, +r: P.Request, +ctx: D.Context) -> FieldsSafe(Route.render_authenticated(m, r, ctx)):
  concatenate_fields_safe(Route.render_received(m, r), Q.concatenate(Route.micro_authentication(m), [Q.Authenticated{r, Some{ctx}}]),
    received_fields(m, r), concatenate_fields_safe(Route.micro_authentication(m), [Q.Authenticated{r, Some{ctx}}],
      micro_authentication(m), without_field(Q.Authenticated{r, Some{ctx}}, {==})))

def verified_fields(+m: Route.Micro, +r: P.Request, +ctx: D.Context) -> FieldsSafe(Route.render_verified(m, r, ctx)):
  concatenate_fields_safe(Route.render_authenticated(m, r, ctx), [Q.Accepts{r, ctx}],
    authenticated_fields(m, r, ctx), without_field(Q.Accepts{r, ctx}, {==}))

def started_fields(+m: Route.Micro, +r: P.Request, +ctx: D.Context) -> FieldsSafe(Route.render_started(m, r, ctx)):
  concatenate_fields_safe(Route.render_verified(m, r, ctx), Q.concatenate(Route.micro_execution(m), [Q.Started{r, ctx}]),
    verified_fields(m, r, ctx), concatenate_fields_safe(Route.micro_execution(m), [Q.Started{r, ctx}],
      micro_execution(m), without_field(Q.Started{r, ctx}, {==})))

def execution_fields(+m: Route.Micro, +r: P.Request, +ctx: D.Context, +xs: List<&2, Q.FrameExec>) ->
  FieldsSafe(Route.render_execution(m, r, ctx, xs)):
  concatenate_fields_safe(Route.render_started(m, r, ctx), Q.expand_exec(r, ctx, xs),
    started_fields(m, r, ctx), list_without_fields(Q.expand_exec(r, ctx, xs), execution_without_fields(r, ctx, xs)))

def concatenate_without_fields(xs: List<&2, Q.Frame>, -ys: List<&2, Q.Frame>, a: WithoutFields(xs), b: WithoutFields(ys)) ->
  WithoutFields(Q.concatenate(xs, ys)):
  match xs a:
    case Nil{} _: b
    case Con{h, t} L.Both{head, tail}: L.Both{head, concatenate_without_fields(t, ys, tail, b)}

def later_delivery_without_fields(closes: Bool, -s: D.State, next: Bool) ->
  WithoutFields(Route.later_delivery(closes, s, next)):
  match closes next:
    case True{} _: L.Both{{==}, Unit{}}
    case False{} True{}: L.Both{{==}, Unit{}}
    case False{} False{}: Unit{}

def delivery_without_fields(+s: D.State, +bs: List<&2, U32>, +closes: Bool, delivery: Route.Delivery) ->
  WithoutFields(Route.render_delivery(s, bs, closes, delivery)):
  match delivery:
    case Route.Complete{next}: L.Both{{==}, later_delivery_without_fields(closes, s, next)}
    case Route.Broken{prefix}: L.Both{{==}, L.Both{{==}, Unit{}}}
    case Route.PendingDelivery{}: Unit{}

def publication_without_fields(r: S.Response, -s: D.State) -> WithoutFields(Route.render_publication(r, s)):
  match r:
    case S.Response{S.Success{}, v}: L.Both{{==}, Unit{}}
    case S.Response{S.Refusal{}, v}: Unit{}
    case S.Response{S.Input{}, v}: Unit{}
    case S.Response{S.Authentication{}, v}: Unit{}
    case S.Response{S.Certificate{}, v}: Unit{}
    case S.Response{S.DataError{}, v}: Unit{}
    case S.Response{S.Limit{}, v}: Unit{}
    case S.Response{S.Failure{}, v}: Unit{}

def conclusion_without_fields(conclusion: N.Conclusion, +closes: Bool, delivery: Route.Delivery) ->
  WithoutFields(Route.render_conclusion(conclusion, closes, delivery)):
  match conclusion:
    case N.Conclusion{+s, +r, +bs}:
      L.Both{{==}, concatenate_without_fields(Route.render_publication(r, s),
        Con{Q.Completed{r, s, closes}, Route.render_delivery(s, bs, closes, delivery)},
        publication_without_fields(r, s), L.Both{{==}, delivery_without_fields(s, bs, closes, delivery)})}

def error_framed_without_fields(q: Maybe<&2, List<&2, U32>>, +r: S.Response,
  +s: D.State, +closes: Bool, delivery: Route.Delivery) ->
  WithoutFields(Route.render_error_framed(q, r, s, closes, delivery)):
  match q:
    case None{}: Unit{}
    case Some{+bs}:
      L.Both{{==}, L.Both{{==}, delivery_without_fields(s, bs, closes, delivery)}}

def error_without_fields(+status: S.Status, +s: D.State, +closes: Bool, delivery: Route.Delivery) ->
  WithoutFields(Route.render_error(status, s, closes, delivery)):
  error_framed_without_fields(P.frame(S.response_value(S.response_error(status))), S.response_error(status), s, closes, delivery)

def frame_prepared_without_field(p: N.Prepared) -> FieldsSafe([Route.frame_prepared(p)]):
  match p:
    case N.Prepared{w, ts, +r, +bs}: without_field(Q.Prepared{r, bs}, {==})

def phase_fields(+m: Route.Micro, phase: Route.PhaseBefore) -> FieldsSafe(Route.render_phase(m, phase)):
  match phase:
    case Route.BeforeInput{}: micro_input(m)
    case Route.AfterReceive{r}: received_fields(m, r)
    case Route.AfterAuthenticate{r, ctx}: authenticated_fields(m, r, ctx)
    case Route.AfterVerify{r, ctx}: verified_fields(m, r, ctx)
    case Route.Executing{r, ctx, xs}: execution_fields(m, r, ctx, xs)
    case Route.AfterPrepare{+r, +ctx, +xs, +p}:
      concatenate_fields_safe(Route.render_execution(m, r, ctx, xs), Q.concatenate(Route.micro_output(m), [Route.frame_prepared(p)]),
        execution_fields(m, r, ctx, xs), concatenate_fields_safe(Route.micro_output(m), [Route.frame_prepared(p)],
          micro_output(m), frame_prepared_without_field(p)))


def initial_without_fields(q: Maybe<&2, List<&2, U32>>, -s: D.State) -> WithoutFields(Route.render_initial(q, s)):
  match q:
    case None{}: L.Both{{==}, Unit{}}
    case Some{bs}: L.Both{{==}, L.Both{{==}, L.Both{{==}, Unit{}}}}

def failure_end_without_fields(+s: D.State, fatal: Bool, delivery: Route.Delivery) -> WithoutFields(Route.render_failure_end(s, fatal, delivery)):
  match fatal:
    case True{}: L.Both{{==}, Unit{}}
    case False{}: error_without_fields(S.Failure{}, s, False{}, delivery)

def failure_without_fields(+s: D.State, stage: X.Stage, id: String, +fatal: Bool, delivery: Route.Delivery) ->
  WithoutFields(Route.render_failure(s, stage, id, fatal, delivery)):
  L.Both{{==}, failure_end_without_fields(s, fatal, delivery)}

def fatal_published_without_fields(c: N.Conclusion, stage: X.Stage, id: String) ->
  WithoutFields(Route.render_fatal_published(c, stage, id)):
  match c:
    case N.Conclusion{+s, +r, bs}:
      L.Both{{==}, concatenate_without_fields(Route.render_publication(r, s), [Q.Failed{stage, id, True{}}, Q.Closed{}],
        publication_without_fields(r, s), L.Both{{==}, L.Both{{==}, Unit{}}})}

def prefix_initial_fields(+m: Route.Micro, accepts: Bool) -> FieldsSafe(Route.prefix_initial(m, accepts)):
  match accepts:
    case True{}: concatenate_fields_safe([Q.InitialAccepts{}], Route.micro_output(m), without_field(Q.InitialAccepts{}, {==}), micro_output(m))
    case False{}: empty_safe()

law all_phases_check_fields_before_of_construct:
  for +m: Route.Micro
  for +s: D.State
  for branch: Route.Branch
  FieldsSafe(Route.render_branch(m, s, branch))
def all_phases_check_fields_before_of_construct(m, s, branch):
  match branch:
    case Route.InitialOk{}:
      concatenate_fields_safe([Q.InitialAccepts{}], Q.concatenate(Route.micro_output(m), Route.render_initial(P.encode(D.state_value(s)), s)),
        without_field(Q.InitialAccepts{}, {==}), concatenate_fields_safe(Route.micro_output(m), Route.render_initial(P.encode(D.state_value(s)), s),
          micro_output(m), list_without_fields(Route.render_initial(P.encode(D.state_value(s)), s), initial_without_fields(P.encode(D.state_value(s)), s))))
    case Route.InitialRefusal{+status}: without_field(Q.InitialRefused{status}, {==})
    case Route.InitialFailure{+accepts, +stage, +id, +fatal}:
      concatenate_fields_safe(Route.prefix_initial(m, accepts), [Q.Failed{stage, id, fatal}, Q.InitialRefused{S.Failure{}}],
        prefix_initial_fields(m, accepts), list_without_fields([Q.Failed{stage, id, fatal}, Q.InitialRefused{S.Failure{}}], L.Both{{==}, L.Both{{==}, Unit{}}}))
    case Route.WithoutResponse{}: without_field(Q.Closed{}, {==})
    case Route.InputRefusal{+error, +closes, +delivery}:
      concatenate_fields_safe(Route.micro_input(m), Route.render_error(Route.status_input(error), s, closes, delivery),
        micro_input(m), list_without_fields(Route.render_error(Route.status_input(error), s, closes, delivery), error_without_fields(Route.status_input(error), s, closes, delivery)))
    case Route.AutRefusal{+r, +delivery}:
      concatenate_fields_safe(Route.render_received(m, r), Q.concatenate(Route.micro_authentication(m), Con{Q.Authenticated{r, None{}}, Route.render_error(S.Authentication{}, s, False{}, delivery)}),
        received_fields(m, r), concatenate_fields_safe(Route.micro_authentication(m), Con{Q.Authenticated{r, None{}}, Route.render_error(S.Authentication{}, s, False{}, delivery)},
          micro_authentication(m), list_without_fields(Con{Q.Authenticated{r, None{}}, Route.render_error(S.Authentication{}, s, False{}, delivery)},
            L.Both{{==}, error_without_fields(S.Authentication{}, s, False{}, delivery)})))
    case Route.GateRefusal{+r, +ctx, +delivery}:
      concatenate_fields_safe(Route.render_authenticated(m, r, ctx), Con{Q.Rejected{r, ctx}, Route.render_error(S.Certificate{}, s, False{}, delivery)},
        authenticated_fields(m, r, ctx), list_without_fields(Con{Q.Rejected{r, ctx}, Route.render_error(S.Certificate{}, s, False{}, delivery)},
          L.Both{{==}, error_without_fields(S.Certificate{}, s, False{}, delivery)}))
    case Route.Executed{+r, +ctx, +xs, +p, +delivery}:
      concatenate_fields_safe(Route.render_execution(m, r, ctx, xs), Q.concatenate(Route.micro_output(m), Route.render_final(p, s, False{}, delivery)),
        execution_fields(m, r, ctx, xs), concatenate_fields_safe(Route.micro_output(m), Route.render_final(p, s, False{}, delivery),
          micro_output(m), list_without_fields(Route.render_final(p, s, False{}, delivery), conclusion_without_fields(N.conclude(p, s), False{}, delivery))))
    case Route.FailureBefore{+phase, +stage, +id, +fatal, +delivery}:
      concatenate_fields_safe(Route.render_phase(m, phase), Route.render_failure(s, stage, id, fatal, delivery),
        phase_fields(m, phase), list_without_fields(Route.render_failure(s, stage, id, fatal, delivery), failure_without_fields(s, stage, id, fatal, delivery)))
    case Route.FatalAfterPublication{+r, +ctx, +xs, +p, +stage, +id}:
      concatenate_fields_safe(Route.render_execution(m, r, ctx, xs), Q.concatenate(Route.micro_output(m), Route.render_fatal_published(N.conclude(p, s), stage, id)),
        execution_fields(m, r, ctx, xs), concatenate_fields_safe(Route.micro_output(m), Route.render_fatal_published(N.conclude(p, s), stage, id),
          micro_output(m), list_without_fields(Route.render_fatal_published(N.conclude(p, s), stage, id), fatal_published_without_fields(N.conclude(p, s), stage, id))))
    case Route.Pending{phase}: phase_fields(m, phase)
    case Route.InitialPending{accepts}: prefix_initial_fields(m, accepts)

law protocol_checks_fields_before_of_construct:
  for +m: Route.Micro
  for +s: D.State
  for +branch: Route.Branch
  FieldsSafe(Route.render(m, s, branch))
def protocol_checks_fields_before_of_construct(m, s, branch):
  concatenate_fields_safe([Q.Configured{}], Route.render_branch(m, s, branch),
    without_field(Q.Configured{}, {==}), all_phases_check_fields_before_of_construct(m, s, branch))
