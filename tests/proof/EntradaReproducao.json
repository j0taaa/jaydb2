  "sourceTexts": {
    "ReproMinimo.bend": "import Base\nimport ./contrato/Bytes.bend as B\nimport ./contrato/Dados.bend as D\nimport ./contrato/Semantica.bend as S\nimport ./src/Codec.bend as C\nimport ./src/Entrada.bend as E\n\ndef corpo() -> List<&2, U32>:\n  [4, 255, 255, 255, 255, 255, 255, 255, 255]\nlaw medida_real_nove:\n  {B.nat64(B.comprimento(corpo())) == Some{B.Numero64{0, 9}} : Maybe<&2, B.Numero64>}\ndef medida_real_nove():\n  {==}\nlaw corpo_cabe_no_teto:\n  {C.menor_igual64(B.Numero64{0, 9}, B.Numero64{0, 32768}) == True{} : Bool}\ndef corpo_cabe_no_teto():\n  {==}\nlaw codec_original_reproduz_limite:\n  {C.decodificar(corpo(), B.Numero64{0, 32768}) == C.Limite{} : C.Resultado}\ndef codec_original_reproduz_limite():\n  {==}\nlaw adaptador_original_reproduz_status_incorreto:\n  {E.ler_mensagem(Some{B.Numero64{0, 32768}}, corpo(), D.Estado{Nil{}, Nil{}}) == E.ErroMensagem{S.Limite{}} : E.PreAutenticacao}\ndef adaptador_original_reproduz_status_incorreto():\n  {==}\n",
    "ReproInterface.bend": "import Base\nimport ./contrato/Bytes.bend as B\nimport ./contrato/Dados.bend as D\nimport ./contrato/Semantica.bend as S\nimport ./contrato/Recursos.bend as X\nimport ./contrato/Interface.bend as I\nimport ./contrato/Logica.bend as L\nimport ./src/Codec.bend as C\nimport ./src/Entrada.bend as E\nimport ./proof/EntradaRecusas.bend as Recusas\nimport ./proof/Fundamentos.bend as F\n\ndef corpo() -> List<&2, U32>:\n  [4, 255, 255, 255, 255, 255, 255, 255, 255]\ndef estado() -> D.Estado:\n  D.Estado{Nil{}, Nil{}}\ndef configuracao() -> S.Configuracao:\n  S.Configuracao{D.Esquema{Nil{}}, S.NenhumaLei{},\n    S.Limites{9n, 9n, 9n, 9n, 1n, 1n, 1n, 1n, 1n}, \"repro-sem-instanciar-ambiente\"}\ndef recepcao() -> X.Recepcao:\n  X.CorpoRecebido{0, 9, corpo()}\ndef cenario() -> I.Cenario:\n  I.Atender{0n, configuracao(), estado(), recepcao()}\ndef eh_recusa_limite(d: X.Disposicao) -> Bool:\n  match d:\n    case X.RecusarEncerrar{S.Limite{}}:\n      True{}\n    case _:\n      False{}\n\nlaw medida_real_e_nove:\n  {B.nat64(B.comprimento(corpo())) == Some{B.Numero64{0, 9}} : Maybe<&2, B.Numero64>}\ndef medida_real_e_nove():\n  {==}\nlaw codec_original_devolve_limite:\n  {C.decodificar(corpo(), B.Numero64{0, 9}) == C.Limite{} : C.Resultado}\ndef codec_original_devolve_limite():\n  {==}\nlaw adaptador_atual_devolve_limite:\n  {E.ler_mensagem(Some{B.Numero64{0, 9}}, corpo(), estado()) == E.ErroMensagem{S.Limite{}} : E.PreAutenticacao}\ndef adaptador_atual_devolve_limite():\n  {==}\nlaw recepcao_e_valida:\n  X.RecepcaoValida(recepcao())\ndef recepcao_e_valida():\n  {==}\nlaw recepcao_admite_o_corpo:\n  {X.decidir_recepcao(configuracao(), recepcao()) == X.ProcessarCorpo{corpo()} : X.Disposicao}\ndef recepcao_admite_o_corpo():\n  {==}\nlaw limite_na_entrada_original_e_impossivel:\n  for alegado: I.LimiteNaEntrada(cenario())\n  Empty\ndef limite_na_entrada_original_e_impossivel(alegado):\n  F.falso_nao_verdadeiro(Equal.cong(X.Disposicao, Bool, eh_recusa_limite,\n    X.decidir_recepcao(configuracao(), recepcao()), X.RecusarEncerrar{S.Limite{}}, alegado))\nlaw corpo_malformado_satisfaz_entrada_invalida_original:\n  I.EntradaInvalida(cenario())\ndef corpo_malformado_satisfaz_entrada_invalida_original():\n  Recusas.codec_limite_no_corpo_admissivel_real_exclui_requisicao_original(0n, configuracao(), estado(),\n    recepcao(), corpo(), B.Numero64{0, 9}, B.Numero64{0, 9}, recepcao_admite_o_corpo(),\n    medida_real_e_nove(), {==}, codec_original_devolve_limite())\nlaw enquadramento_completo_preserva_canal:\n  I.FechamentoCorreto(cenario(), False{})\ndef enquadramento_completo_preserva_canal():\n  {==}\nlaw disposicao_de_erro_original_continua:\n  {X.corpo_invalido() == X.RecusarContinuar{S.Entrada{}} : X.Disposicao}\ndef disposicao_de_erro_original_continua():\n  {==}\n",
    "DesejadoRejeitado.bend": "import Base\nimport ./ReproMinimo.bend as R\nimport ./contrato/Bytes.bend as B\nimport ./contrato/Dados.bend as D\nimport ./contrato/Semantica.bend as S\nimport ./src/Entrada.bend as E\nlaw falso:\n  {E.ler_mensagem(Some{B.Numero64{0, 32768}}, R.corpo(), D.Estado{Nil{}, Nil{}}) == E.ErroMensagem{S.Entrada{}} : E.PreAutenticacao}\ndef falso():\n  {==}\n"
