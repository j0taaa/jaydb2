import Base
import ../../../contract/Data.bend as D
import ../../../contract/Requirements.bend as R
import ../../../contract/RequestFacts.bend as I
import ./Configuration.bend as C
import ./Client.bend as Client
import ./Instance.bend as Instance

def code() -> String:
  "import Base\nimport ../../../contract/Data.bend as D\nimport ../../../contract/Semantics.bend as S\n\ntype Command is Data:\n  ListTasks{}\n  View{id: String}\n  Save{id: String, title: String, completed: Bool, cancel: Bool}\n  Remove{id: String}\n  Conclude{id: String}\n  Invalid{}\n\ndef combined_id(+action: String, +id: String) -> Command:\n  Bool.pick(Command, String.eq(action, \"view\"), View{id},\n    Bool.pick(Command, String.eq(action, \"remove\"), Remove{id},\n      Bool.pick(Command, String.eq(action, \"conclude\"), Conclude{id}, Invalid{})))\n\ndef combined_task_cases(save: Bool, cancel: Bool, id: String, title: String, completed: Bool) -> Command:\n  match save cancel:\n    case True{} _: Save{id, title, completed, False{}}\n    case False{} True{}: Save{id, title, completed, True{}}\n    case False{} False{}: Invalid{}\n\ndef combined_task(+action: String, id: String, title: String, completed: Bool) -> Command:\n  combined_task_cases(String.eq(action, \"save\"), String.eq(action, \"cancel\"), id, title, completed)\n\ndef analyze(args: D.Value) -> Command:\n  match args:\n    case D.VList{D.VText{action}, D.VListEmpty{}}:\n      Bool.pick(Command, String.eq(action, \"list\"), ListTasks{}, Invalid{})\n    case D.VList{D.VText{action}, D.VList{D.VText{id}, D.VListEmpty{}}}:\n      combined_id(action, id)\n    case D.VList{D.VText{action}, D.VList{D.VText{id}, D.VList{D.VText{title}, D.VList{D.VBool{done}, D.VListEmpty{}}}}}:\n      combined_task(action, id, title, done)\n    case _: Invalid{}\n\ndef fields(+owner: String, +id: String, title: String, done: Bool) -> List<&2, D.Field>:\n  [D.Field{\"completed\", D.VBool{done}}, D.Field{\"id\", D.VText{id}},\n    D.Field{\"owner\", D.VText{owner}}, D.Field{\"title\", D.VText{title}}]\n\ndef keys(xs: List<&2, String>) -> D.Value:\n  match xs:\n    case Nil{}: D.VListEmpty{}\n    case Con{k, rest}: D.VList{D.VText{k}, keys(rest)}\n\ndef list_value(r: S.Return) -> D.Value:\n  match r:\n    case S.Datum{D.Keys{ks}}: keys(ks)\n    case _: D.VAbsent{}\n\ndef listed(r: S.Return) -> S.Action:\n  S.Finish{list_value(r)}\n\ndef detail_value(owner: String, id: String, title: String, r: S.Return) -> D.Value:\n  match r:\n    case S.Datum{D.Cell{D.VBool{done}}}:\n      D.VRecord{\"completed\", D.VBool{done},\n        D.VRecord{\"id\", D.VText{id}, D.VRecord{\"owner\", D.VText{owner},\n          D.VRecord{\"title\", D.VText{title}, D.VRecordEmpty{}}}}}\n    case _: D.VAbsent{}\n\ndef detail(owner: String, id: String, title: String, r: S.Return) -> S.Action:\n  S.Finish{detail_value(owner, id, title, r)}\n\ndef text_received(r: S.Return) -> Maybe<&2, String>:\n  match r:\n    case S.Datum{D.Cell{D.VText{title}}}: Some{title}\n    case _: None{}\n\ndef resume_title(+owner: String, +id: String, title: Maybe<&2, String>) -> S.Action:\n  match title:\n    case Some{text}:\n      S.Access{D.ReadCell{D.Application{owner}, id, \"completed\"}, detail(owner, id, text)}\n    case None{}: S.Finish{D.VAbsent{}}\n\ndef title_received(owner: String, id: String, r: S.Return) -> S.Action:\n  resume_title(owner, id, text_received(r))\n\ndef conclude_title(+owner: String, +id: String, title: Maybe<&2, String>) -> S.Action:\n  match title:\n    case Some{text}:\n      S.Access{D.DefineRow{D.Application{owner}, id, fields(owner, id, text, True{})},\n        unit => S.Finish{D.VText{id}}}\n    case None{}: S.Refuse{D.VText{\"task not found\"}}\n\ndef conclude_received(owner: String, id: String, r: S.Return) -> S.Action:\n  conclude_title(owner, id, text_received(r))\n\ndef saved(cancel: Bool, id: String) -> S.Action:\n  match cancel:\n    case False{}: S.Finish{D.VText{id}}\n    case True{}: S.Refuse{D.VText{\"cancelled\"}}\n\ndef command(+owner: String, p: Command) -> S.Action:\n  match p:\n    case ListTasks{}:\n      S.Access{D.EnumerateKeys{D.Application{owner}}, listed}\n    case View{+id}:\n      S.Access{D.ReadCell{D.Application{owner}, id, \"title\"}, title_received(owner, id)}\n    case Save{+id, title, done, cancel}:\n      S.Access{D.DefineRow{D.Application{owner}, id, fields(owner, id, title, done)},\n        unit => saved(cancel, id)}\n    case Conclude{+id}:\n      S.Access{D.ReadCell{D.Application{owner}, id, \"title\"}, conclude_received(owner, id)}\n    case Remove{+id}:\n      S.Access{D.RemoveRow{D.Application{owner}, id}, unit => S.Finish{D.VText{id}}}\n    case Invalid{}: S.Refuse{D.VText{\"invalid request\"}}\n\ndef start(ctx: D.Context, args: D.Value) -> S.Action:\n  D.Context{id, kind} = ctx\n  command(id, analyze(args))\n\ndef program() -> S.Program:\n  S.Program{start}\n"

law certificate:
  R.Certifies(C.config(), code(), Client.program(), Instance.context(), Instance.arguments())

law terminates:
  I.ProgramTerminates(C.config(), Client.program())

def proof_source() -> String:
  "import Base\nimport ../../../contract/Data.bend as D\nimport ../../../contract/Semantics.bend as S\nimport ../../../contract/Logic.bend as L\nimport ../../../contract/Requirements.bend as R\nimport ../../../src/Termination.bend as T\nimport ./Policy.bend as P\nimport ./Proofs.bend as H\nimport ./Configuration.bend as C\nimport ./Client.bend as Client\nimport ./Instance.bend as I\nimport ./Bindings.bend as B\n\ndef title_safe(+id: String, kind: String, +key: String, title: Maybe<&2, String>) ->\n  H.Safe(2n, D.Context{id, kind}, Client.resume_title(id, key, title)):\n  match title:\n    case None{}: Unit{}\n    case Some{text}: L.Both{{==}, r => Unit{}}\n\ndef conclude_safe(+id: String, kind: String, +key: String, title: Maybe<&2, String>) ->\n  H.Safe(2n, D.Context{id, kind}, Client.conclude_title(id, key, title)):\n  match title:\n    case None{}: Unit{}\n    case Some{text}: L.Both{P.Both{{==}, {==}}, r => Unit{}}\n\ndef saved_safe(n: Nat, ctx: D.Context, cancel: Bool, key: String) ->\n  H.Safe(Succ{n}, ctx, Client.saved(cancel, key)):\n  match cancel:\n    case False{}: Unit{}\n    case True{}: Unit{}\n\ndef command_safe(ctx: D.Context, p: Client.Command) ->\n  H.Safe(3n, ctx, Client.command(D.context_id(ctx), p)):\n  match ctx p:\n    case D.Context{id, kind} Client.ListTasks{}: L.Both{{==}, r => Unit{}}\n    case D.Context{+id, kind} Client.View{key}:\n      L.Both{{==}, r => title_safe(id, kind, key, Client.text_received(r))}\n    case D.Context{+id, +kind} Client.Save{+key, title, done, +cancel}:\n      L.Both{P.Both{{==}, {==}}, r => saved_safe(1n, D.Context{id, kind}, cancel, key)}\n    case D.Context{+id, kind} Client.Conclude{key}:\n      L.Both{{==}, r => conclude_safe(id, kind, key, Client.text_received(r))}\n    case D.Context{id, kind} Client.Remove{key}: L.Both{{==}, r => Unit{}}\n    case D.Context{id, kind} Client.Invalid{}: Unit{}\n\ndef program_safe(+ctx: D.Context, args: D.Value) -> H.Safe(3n, ctx, S.start(Client.program(), ctx, args)):\n  match ctx:\n    case D.Context{id, kind}: command_safe(D.Context{id, kind}, Client.analyze(args))\n\ndef owners_initial(-s: D.State, valid: R.Valid(C.config(), s)) -> P.Owners(s):\n  match valid:\n    case L.Both{structure, L.Both{owners, remaining}}: owners\n\n# The parameterized lemma avoids reevaluating concrete argument reification\n# throughout the proof; the target remains the original certificate.\ndef certify(+ctx: D.Context, +args: D.Value, -code: String, +s: D.State,\n  valid: R.Valid(C.config(), s), identity: {D.context_present(s, ctx) == True{} : Bool}, +n: Nat) ->\n  R.SafetyTrace(S.execute(n, Client.program(), C.schema(), s, ctx, args), C.config(), s, ctx, code, args):\n  H.execution_trace(S.execute(n, Client.program(), C.schema(), s, ctx, args),\n    C.schema(), C.limits(), C.environment(), s, ctx, code, args,\n    H.rewind(ctx, S.execute(n, Client.program(), C.schema(), s, ctx, args),\n      T.observe(n, S.start(Client.program(), ctx, args), C.schema(), s, Nil{}),\n      Equal.sym(S.Trace, T.observe(n, S.start(Client.program(), ctx, args), C.schema(), s, Nil{}),\n        S.execute(n, Client.program(), C.schema(), s, ctx, args),\n        T.reference(n, S.start(Client.program(), ctx, args), C.schema(), s)),\n      H.safe(3n, n, S.start(Client.program(), ctx, args), ctx, C.schema(), s, Nil{},\n        program_safe(ctx, args), P.Both{owners_initial(s, valid), P.Both{identity, Unit{}}})))\n\ndef B.certificate(s, valid, identity, n):\n  certify(I.context(), I.arguments(), B.code(), s, valid, identity, n)\n\ndef B.terminates(s, ctx, args):\n  +ctx = ctx\n  +args = args\n  T.program_finite(3n, Client.program(), C.schema(), s, ctx, args,\n    H.finite(3n, S.start(Client.program(), ctx, args), ctx, program_safe(ctx, args)))\n"
